{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node", "next"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "out-tsc",
    "dist",
    ".next",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "vitest.config.ts",
    "vitest.config.mts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "src/test-setup.ts"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "next-env.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/welcome/tsconfig.lib.json"
    },
    {
      "path": "../../packages/theme/tsconfig.lib.json"
    },
    {
      "path": "../../packages/script-workspace/tsconfig.lib.json"
    },
    {
      "path": "../../packages/script-session/tsconfig.lib.json"
    },
    {
      "path": "../../packages/print/tsconfig.lib.json"
    },
    {
      "path": "../../packages/preview-workspace/tsconfig.lib.json"
    },
    {
      "path": "../../packages/lambda-api/tsconfig.lib.json"
    },
    {
      "path": "../../packages/fountain/tsconfig.lib.json"
    },
    {
      "path": "../../packages/form/tsconfig.lib.json"
    },
    {
      "path": "../../packages/editor-zoom/tsconfig.lib.json"
    },
    {
      "path": "../../packages/editor/tsconfig.lib.json"
    },
    {
      "path": "../../packages/design-system/tsconfig.lib.json"
    },
    {
      "path": "../../packages/command-palette/tsconfig.lib.json"
    },
    {
      "path": "../../packages/auth-forms/tsconfig.lib.json"
    },
    {
      "path": "../../packages/auth/tsconfig.lib.json"
    },
    {
      "path": "../../packages/application-menu/tsconfig.lib.json"
    }
  ]
}
